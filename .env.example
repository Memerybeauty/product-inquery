# LLM 配置
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-3-5-plus-260215
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=600

# MCP 配置（RAG/QA 知识库）
MCP_CONFIG_PATH=./config/mcp.json

# RAGFlow 兜底（当 MCP 不可用时）
RAGFLOW_BASE_URL=http://localhost:8081
RAGFLOW_API_KEY=
RAGFLOW_DATASET_TLF=
RAGFLOW_DATASET_DW=

# MinIO / 资产（暂用 stub，生产接入时填）
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=airag-files
ASSET_API_BASE_URL=http://localhost:18080

# 阈值（v3 拍板）
CONFIDENCE_THRESHOLD_DOC=0.7
CONFIDENCE_THRESHOLD_INTERNET=0.6

# 联网搜索
INTERNET_SEARCH_ENABLED=true

# 灰度（生产用，本地默认 false）
ROLLOUT_PERCENT=0
AGENT_HARNESS_BACKEND=deepagents
